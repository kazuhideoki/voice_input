# OpenAI API key for OpenAI-based providers.
TRANSCRIPTION_API_KEY=your_openai_api_key_here

# Startup default provider: gpt-transcribe, gpt-live-transcribe, mlx-qwen3-asr.
# `voice_input config set transcription-provider ...` or a command flag can override it.
VOICE_INPUT_DEFAULT_TRANSCRIPTION_PROVIDER=gpt-transcribe

# GPT Transcribe streaming direct input default.
# `voice_input config set transcribe-streaming ...` can override it.
VOICE_INPUT_DEFAULT_TRANSCRIBE_STREAMING=false

# Investigation log.
# OPENAI_TRANSCRIPTION_LOG_PATH=/tmp/voice_input-transcription-log.jsonl

# Recording / audio input.
# User-setting defaults. `voice_input config set ...` can override them.
VOICE_INPUT_DEFAULT_MAX_SECS=30
VOICE_INPUT_DEFAULT_PRE_ROLL_MS=500
VOICE_INPUT_DEFAULT_RECORDING_SOUNDS_ENABLED=true
VOICE_INPUT_DEFAULT_RECORDING_HUD_ENABLED=true
VOICE_INPUT_DEFAULT_INPUT_DEVICE_PRIORITIES="device1,device2,device3"

# Push-to-talk defaults. Set false for traditional start/stop/toggle usage.
VOICE_INPUT_DEFAULT_PUSH_TO_TALK_ENABLED=true
VOICE_INPUT_DEFAULT_PUSH_TO_TALK_HOTKEY=opt+8

# Optional paths.
# VOICE_INPUT_ENV_PATH=/path/to/.env
# VOICE_INPUT_SOCKET_PATH=/tmp/voice_input.sock
# VOICE_INPUT_SOCKET_DIR=/tmp
# XDG_DATA_HOME=/custom/xdg/data
