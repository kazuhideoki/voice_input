# OpenAI API key for OpenAI-based providers.
TRANSCRIPTION_API_KEY=your_openai_api_key_here

# Default provider: 4o, realtime-whisper, mlx-qwen3-asr. (--transcription-provider フラグで上書き可能)
VOICE_INPUT_DEFAULT_TRANSCRIPTION_PROVIDER=realtime-whisper

# 4o streaming direct input.
OPENAI_TRANSCRIBE_STREAMING=false

# Investigation / result handling.
# OPENAI_TRANSCRIPTION_LOG_PATH=/tmp/voice_input-transcription-log.jsonl
VOICE_INPUT_LOW_CONFIDENCE_SELECTION=false

# Recording / audio input.
VOICE_INPUT_MAX_SECS=30
VOICE_INPUT_PRE_ROLL_MS=500
VOICE_INPUT_RECORDING_SOUNDS=true
INPUT_DEVICE_PRIORITY="device1,device2,device3"

# Push-to-talk. Set false for traditional start/stop/toggle usage.
VOICE_INPUT_PUSH_TO_TALK=true
VOICE_INPUT_PUSH_TO_TALK_HOTKEY=opt+8

# Optional paths.
# VOICE_INPUT_ENV_PATH=/path/to/.env
# VOICE_INPUT_SOCKET_PATH=/tmp/voice_input.sock
# VOICE_INPUT_SOCKET_DIR=/tmp
# XDG_DATA_HOME=/custom/xdg/data
