# Runtime backend switching is controlled by the client flag:
#   voice_input start --transcription-provider 4o
#   voice_input start --transcription-provider 4o --transcription-model gpt-4o-mini-transcribe
#   voice_input start --transcription-provider realtime-whisper
#   voice_input start --transcription-provider mlx-qwen3-asr

# Transcription API key for OpenAI backend
# Legacy OPENAI_API_KEY is still supported for backward compatibility
TRANSCRIPTION_API_KEY=your_openai_api_key_here

# Enable streaming direct input
OPENAI_TRANSCRIBE_STREAMING=false

# Local audio pre-roll attached at recording start.
# Set to 0 to disable.
VOICE_INPUT_PRE_ROLL_MS=500

# Optional: record while the configured hotkey is held down.
# The matching key event is suppressed while this is enabled.
# Default: false, default hotkey: opt+8
VOICE_INPUT_PUSH_TO_TALK=false
VOICE_INPUT_PUSH_TO_TALK_HOTKEY=opt+8

# Example for mlx-qwen3-asr:
# voice_input start --transcription-provider mlx-qwen3-asr

# Example for realtime-whisper:
# voice_input start --transcription-provider realtime-whisper

# Optional: save transcription investigation logs as a JSON Lines file
# When unset, logging is disabled
# OPENAI_TRANSCRIPTION_LOG_PATH=/tmp/voice_input-transcription-log.jsonl

# Optional: auto-select the lowest-confidence transcription span after input completes
# Default: false
VOICE_INPUT_LOW_CONFIDENCE_SELECTION=false

# Input device priority (comma-separated list of device names)
# The first device in the list has the highest priority.
INPUT_DEVICE_PRIORITY="device1,device2,device3"
